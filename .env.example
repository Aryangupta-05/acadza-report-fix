PORT=3100
# Gemini free-tier API key; never enable billing just for this demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
# Alternative OpenAI provider (requires separately approved spend)
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=
# Local defaults to durable SQLite. Production requires PostgreSQL.
DATABASE_PATH=runtime/acadza.sqlite
# Optional shared reviewer token in production. Public visitors receive isolated durable demo workspaces.
REVIEW_TOKEN=

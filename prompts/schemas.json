        "type": "string"
      },
      "questionId": {
        "type": "string"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "defect",
          "no_error",
          "display_issue",
          "app_issue",
          "language_mode",
          "already_fixed",
          "not_actionable"
        ]
      },
      "repair": {
        "anyOf": [
          {
            "type": "string",

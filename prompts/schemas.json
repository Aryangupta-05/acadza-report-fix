{
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reportId",
      "questionId",
      "verdict",
      "repair",
      "edit",
      "route",
      "confidence",
      "evidence",
      "student_reply"
    ],

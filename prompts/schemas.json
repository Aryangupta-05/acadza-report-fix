              "spelling",
              "noise",
              "exam_reference",
              "markup_leak",
              "answer_form",
              "notation",
              "stem_data",
              "option_repair",
              "solution_fix",
              "solution_missing",
              "answer_key",
              "type_mismatch",
              "identical_options",
              "diagram",
              "wrong_question",
              "unsound",
              "wrong_chapter",
              "syllabus"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "edit": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "find",
              "replace"
            ],
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "question",
                  "solution",
                  "answer",
                  "questionType"
                ]
              },
              "find": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "replace": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "route": {
        "type": "string",
        "enum": [
          "auto_apply",
          "faculty_review",
          "no_change"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "evidence": {
        "type": "string",
        "minLength": 5,
        "maxLength": 2200
      },
      "student_reply": {
        "type": "string",
        "minLength": 5,
        "maxLength": 700
      }
    }
  },
